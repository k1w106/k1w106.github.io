---
import Button from '@/components/common/Button.astro';
import Card from '@/components/common/Card.astro';
import FallingLeaves from '@/components/effects/FallingLeaves.astro';
import FallingPetals from '@/components/effects/FallingPetals.astro';
import FallingSnow from '@/components/effects/FallingSnow.astro';
import HeatShimmer from '@/components/effects/HeatShimmer.astro';
import Layout from '@/components/layout/Layout.astro';
import Highlight from '@/components/common/Highlight.astro';
import Icon from '@/components/common/Icon.astro';
import InstantPhoto from '@/components/common/InstantPhoto.astro';
import PageHero from '@/components/common/PageHero.astro';
import Sunlight from '@/components/effects/Sunlight.astro';
import portrait from '@/assets/home/portrait.jpg';
import { getIcon } from '@/lib/icons';
import { withBase } from '@/lib/paths';
import { AUTHOR_NAME, GITHUB_URL, JOB_TITLE, LINKEDIN_URL, SITE_DESCRIPTION, SITE_NAME } from '@/lib/site';

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR_NAME,
  jobTitle: JOB_TITLE,
  url: new URL(withBase('/'), Astro.site).toString(),
  sameAs: [GITHUB_URL, LINKEDIN_URL].filter(Boolean),
}).replace(/</g, '\\u003c');

const highlights = [
  {
    icon: getIcon('leaf'),
    title: 'Four seasons',
    description: 'Autumn, winter, spring, and summer palettes that follow the calendar.',
  },
  {
    icon: getIcon('sun-moon'),
    title: 'Light and dark',
    description: 'Every season has both modes, and the toggle remembers your choice.',
  },
  {
    icon: getIcon('article'),
    title: 'Blog ready',
    description: 'Markdown and MDX posts with tags, an RSS feed, and instant search.',
  },
];
---

<Layout title={SITE_NAME} description={SITE_DESCRIPTION} canonicalPath="/">
  <script type="application/ld+json" is:inline set:html={personSchema}></script>
  <FallingLeaves />
  <FallingSnow />
  <FallingPetals />
  <Sunlight />
  <HeatShimmer>
    <main class="content-shell">
      <PageHero title="Home" hideTitle>
        <div
          class:list={[
            'flex',
            'items-center',
            'justify-between',
            'gap-12',
            'max-md:flex-col',
            'max-md:items-start',
            'max-md:gap-8',
          ]}
        >
          <div class="flex flex-col items-start gap-8">
            <h2 class:list={['text-[clamp(3rem,4.5vw,4.25rem)]', 'leading-[1.1]', 'tracking-[-0.03em]']}>
              A <Highlight handDrawn>season-aware</Highlight>, <Highlight handDrawn>neobrutalist</Highlight> theme for
              <Highlight handDrawn>your blog</Highlight>
            </h2>
            <div class="flex flex-wrap gap-4">
              <Button href={withBase('/blog/')}>
                Read the blog
                <Icon icon={getIcon('arrow-right')} />
              </Button>
              <Button href={withBase('/projects/')} variant="secondary">
                See projects
              </Button>
            </div>
          </div>
          <InstantPhoto
            src={portrait}
            alt="A tabby cat with wide golden eyes looking straight at the camera"
            caption="Strike a pose!"
            loading="eager"
            class:list={['w-full', 'max-w-72', 'sm:max-w-96', 'md:max-w-72', 'max-md:self-center', 'shrink-0']}
          />
        </div>
      </PageHero>

      <section class="section" aria-label="About">
        <div class="flex-column justify-center w-full mt-10">
          <Card>
            <div class="about-prose">
              <!-- prettier-ignore -->
              <p>
                <Highlight bold handDrawn>Seasons</Highlight> is a <Highlight bold handDrawn>neobrutalist</Highlight> Astro theme for personal sites and blogs. Its colors follow the calendar, moving through <Highlight bold handDrawn>autumn</Highlight>, <Highlight bold handDrawn>winter</Highlight>, <Highlight bold handDrawn>spring</Highlight>, and <Highlight bold handDrawn>summer</Highlight>, each with a light and a dark mode.
              </p>

              <!-- prettier-ignore -->
              <p>
                Replace this card with a short introduction about yourself, and <Highlight bold handDrawn>make it yours</Highlight>.
              </p>
            </div>
          </Card>

          <h2
            id="highlights-heading"
            class:list={['mt-16', 'mb-8', 'text-[clamp(2rem,3.2vw,2.75rem)]', 'leading-[1.1]', 'tracking-[-0.03em]']}
          >
            What you <Highlight handDrawn>get</Highlight>
          </h2>

          <ul aria-labelledby="highlights-heading" class="m-0 grid list-none grid-cols-1 gap-5 p-0 md:grid-cols-3">
            {highlights.map(({ icon, title, description }) => (
              <Card as="li" class="flex min-h-72 flex-col p-8">
                <span
                  class:list={[
                    'inline-flex',
                    'size-14',
                    'items-center',
                    'justify-center',
                    'border-2',
                    'border-ink',
                    'bg-accent',
                    'text-bg',
                    'shadow-[3px_3px_0_0_var(--ink)]',
                  ]}
                >
                  <Icon icon={icon} class="size-7" />
                </span>
                <h3
                  class:list={[
                    'm-0',
                    'mt-6',
                    'text-[1.5em]',
                    'leading-[1.2]',
                    'font-bold',
                    'tracking-[0.005em]',
                    'text-ink',
                  ]}
                >
                  {title}
                </h3>
                <p class="mt-3 text-[1.05rem] leading-[1.55] text-ink-soft">{description}</p>
              </Card>
            ))}
          </ul>
        </div>
      </section>
    </main>
  </HeatShimmer>
</Layout>

<style>
  @reference "@/styles/global.css";

  .about-prose p {
    @apply mb-[1.2rem] font-heading text-[1.3rem] leading-[1.75] last:mb-0;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }
</style>
