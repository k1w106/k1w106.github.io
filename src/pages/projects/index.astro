---
import { PROJECTS_DESCRIPTION, SITE_NAME } from '@/lib/site';
import Layout from '@/components/layout/Layout.astro';
import Lede from '@/components/common/Lede.astro';
import PageHero from '@/components/common/PageHero.astro';
import Projects from '@/components/projects/index.astro';
---

<Layout title=`Projects — ${SITE_NAME}` description={PROJECTS_DESCRIPTION} canonicalPath="/projects/">
  <main class="content-shell">
    <PageHero title="Projects" hideTitle>
      <Lede>{PROJECTS_DESCRIPTION}</Lede>
    </PageHero>

    <Projects />
  </main>
</Layout>
