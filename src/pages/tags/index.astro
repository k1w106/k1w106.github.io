---
import { getCollection } from 'astro:content';
import Layout from '@/components/layout/Layout.astro';
import Lede from '@/components/common/Lede.astro';
import PageHero from '@/components/common/PageHero.astro';
import Tag from '@/components/common/Tag.astro';
import { withBase } from '@/lib/paths';
import { getAllTags } from '@/lib/tags';
import { SITE_NAME, TAGS_DESCRIPTION } from '@/lib/site';

const tags = getAllTags(await getCollection('blog'));
---

<Layout title=`Tags — ${SITE_NAME}` description={TAGS_DESCRIPTION} canonicalPath="/tags/">
  <main class="content-shell">
    <PageHero title="Tags" hideTitle>
      <Lede>{TAGS_DESCRIPTION}</Lede>
    </PageHero>

    <section class="section" aria-label="Tags">
      <div class="flex flex-wrap gap-[0.6rem]">
        {tags.map(({ slug, name, count }) => (
          <Tag href={withBase(`/tags/${slug}/`)} size="lg">
            #{name} {count > 0 && <span class="font-normal opacity-70">{count}</span>}
          </Tag>
        ))}
      </div>
    </section>
  </main>
</Layout>
