---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '@/components/layout/Layout.astro';
import Lede from '@/components/common/Lede.astro';
import PageHero from '@/components/common/PageHero.astro';
import PostCard from '@/components/posts/PostCard.astro';
import { getAllTags, slugifyTag } from '@/lib/tags';
import { SITE_NAME } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const published = posts
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return getAllTags(posts).map(({ slug, name }) => ({
    params: { tag: slug },
    props: {
      name,
      posts: published.filter((post) => post.data.tags.some((tag) => slugifyTag(tag) === slug)),
    },
  }));
}

interface Props {
  name: string;
  posts: CollectionEntry<'blog'>[];
}

const { name, posts } = Astro.props;
const slug = Astro.params.tag!;
---

<Layout title={`#${name} — ${SITE_NAME}`} description={`Posts tagged "${name}".`} canonicalPath={`/tags/${slug}/`}>
  <main class="content-shell">
    <PageHero title={`# ${name}`}>
      <Lede>
        {posts.length === 0
          ? 'Nothing here yet — check back soon.'
          : `${posts.length} post${posts.length === 1 ? '' : 's'} tagged ${name}.`}{' '}
      </Lede>
    </PageHero>

    {posts.length > 0 && (
      <section class="section" aria-label="Posts">
        <div class="grid gap-8">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
