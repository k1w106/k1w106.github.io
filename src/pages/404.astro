---
import Layout from '@/components/layout/Layout.astro';
import Lede from '@/components/common/Lede.astro';
import PageHero from '@/components/common/PageHero.astro';
import { withBase } from '@/lib/paths';
import { SITE_NAME } from '@/lib/site';
---

<Layout title=`404 — ${SITE_NAME}` description="Page not found." canonicalPath="/404/">
  <main class="content-shell">
    <PageHero title="404" eyebrow="page not found">
      <Lede>This page doesn't exist. It may have been moved, deleted, or never published.</Lede>
      <div class="mt-7 flex flex-wrap gap-[0.6rem]">
        <a class="button button-primary" href={withBase('/')}>
          Go home
        </a>
        <a class="button button-secondary" href={withBase('/blog/')}>
          Browse the blog
        </a>
      </div>
    </PageHero>
  </main>
</Layout>

<style>
  @reference "@/styles/global.css";

  .button {
    @apply inline-flex min-h-[2.6rem] items-center justify-center rounded-md border border-transparent px-[1.1rem] py-[0.6rem];
    @apply text-[0.9rem] font-semibold transition-all duration-120 ease-[ease];
  }

  .button-primary {
    @apply bg-ink text-bg hover:bg-accent hover:text-white;
  }

  .button-secondary {
    @apply border-line-strong bg-transparent text-ink-soft;
    @apply hover:border-accent hover:bg-accent-soft hover:text-accent;
  }
</style>
