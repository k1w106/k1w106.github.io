---
import { getCollection, render } from 'astro:content';
import Layout from '@/components/layout/Layout.astro';
import Tag from '@/components/common/Tag.astro';
import { formatPostDate, postSlug } from '@/lib/posts';
import { slugifyTag } from '@/lib/tags';
import { withBase } from '@/lib/paths';
import { AUTHOR_NAME, SITE_NAME } from '@/lib/site';
import { ANIMATED_UNDERLINE_CLASSES } from '@/lib/animatedUnderline';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => {
      const slug = postSlug(post);
      return {
        params: { slug },
        props: { post, slug },
      };
    });
}

const { post, slug } = Astro.props;
const { Content, headings } = await render(post);
const h2Headings = headings.filter((heading) => heading.depth === 2);
const sectionHeadings = h2Headings.length > 0 ? h2Headings : headings.filter((heading) => heading.depth === 1);
const tags = post.data.tags.filter((tag) => slugifyTag(tag) !== '');
const articleProseClasses: string[] = ['article-prose', ...ANIMATED_UNDERLINE_CLASSES];

const postSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url: new URL(withBase(`/blog/${slug}/`), Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: new URL(withBase('/'), Astro.site).toString(),
  },
}).replace(/</g, '\\u003c');
---

<Layout
  title={`${post.data.title} — ${SITE_NAME}`}
  description={post.data.description}
  canonicalPath={`/blog/${slug}/`}
  ogType="article"
>
  <script type="application/ld+json" is:inline set:html={postSchema}></script>
  <main class="content-shell">
    <div class="article-layout section">
      <article class="min-w-0">
        <header class="mb-[2.35rem] border-b-4 border-ink pb-8">
          <p class="post-meta">
            <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
          </p>
          <h1
            class:list={[
              'm-0',
              'max-w-[22ch]',
              'text-[clamp(2rem,4vw,3.4rem)]',
              'leading-none',
              'font-semibold',
              'tracking-[0.005em]',
              'text-ink',
            ]}
          >
            {post.data.title}
          </h1>
          <p
            class:list={[
              'mt-[1.2rem]',
              'max-w-[680px]',
              'text-[1.18rem]',
              'leading-[1.7]',
              'text-[color-mix(in_srgb,var(--ink)_68%,var(--muted))]',
            ]}
          >
            {post.data.description}
          </p>
          {tags.length > 0 && (
            <p class="mt-4 flex max-w-[680px] flex-wrap gap-2">
              {tags.map((tag) => (
                <Tag href={withBase(`/tags/${slugifyTag(tag)}/`)}>#{tag}</Tag>
              ))}
            </p>
          )}

          {sectionHeadings.length > 0 && (
            <div class="toc mt-6" data-toc data-open="false">
              <button
                type="button"
                class="toc-toggle"
                data-toc-toggle
                aria-expanded="false"
                aria-controls={`toc-panel-${slug}`}
              >
                <span>Table of contents</span>
                <span class="toc-chevron" aria-hidden="true"></span>
              </button>
              <div id={`toc-panel-${slug}`} class="toc-panel" data-toc-panel inert aria-hidden="true">
                <div class="toc-panel-inner">
                  <nav class="toc-nav" aria-label="Table of contents">
                    {sectionHeadings.map((heading) => (
                      <a href={`#${heading.slug}`} data-heading-link={heading.slug}>
                        <span class="toc-hash" aria-hidden="true">
                          #
                        </span>
                        {heading.text}
                      </a>
                    ))}
                  </nav>
                </div>
              </div>
            </div>
          )}
        </header>
        <div class:list={articleProseClasses}>
          <Content />
        </div>
      </article>
    </div>
  </main>

  <script>
    let tocObserver: IntersectionObserver | undefined;

    function initToc() {
      tocObserver?.disconnect();
      const links = new Map(
        Array.from(document.querySelectorAll('[data-heading-link]')).map((link) => [
          link.getAttribute('data-heading-link'),
          link,
        ]),
      );
      if (links.size === 0) return;

      const headings = Array.from(
        document.querySelectorAll<HTMLElement>('.article-prose h1[id], .article-prose h2[id]'),
      ).filter((heading) => links.has(heading.id));
      if (headings.length === 0) return;

      function setActive(id: string) {
        for (const link of links.values()) link.removeAttribute('aria-current');
        links.get(id)?.setAttribute('aria-current', 'true');
      }

      setActive(headings[0].id);
      tocObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible?.target instanceof HTMLElement) setActive(visible.target.id);
        },
        { rootMargin: '-18% 0px -68% 0px', threshold: 0 },
      );
      for (const heading of headings) tocObserver.observe(heading);
    }

    function initTocToggle() {
      document.querySelectorAll<HTMLElement>('[data-toc]').forEach((toc) => {
        if (toc.dataset.tocReady === 'true') return;
        toc.dataset.tocReady = 'true';

        const toggle = toc.querySelector('[data-toc-toggle]');
        const panel = toc.querySelector<HTMLElement>('[data-toc-panel]');
        if (!(toggle instanceof HTMLButtonElement) || !panel) return;

        const setOpen = (open: boolean) => {
          toc.dataset.open = String(open);
          toggle.setAttribute('aria-expanded', String(open));
          panel.toggleAttribute('inert', !open);
          panel.setAttribute('aria-hidden', String(!open));
        };

        setOpen(false);
        toggle.addEventListener('click', () => setOpen(toc.dataset.open !== 'true'));
        panel.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            toc.dataset.instant = 'true';
            setOpen(false);
            window.requestAnimationFrame(() => {
              window.requestAnimationFrame(() => {
                delete toc.dataset.instant;
              });
            });
          });
        });
      });
    }

    initToc();
    initTocToggle();
    document.addEventListener('astro:page-load', () => {
      initToc();
      initTocToggle();
    });
  </script>
</Layout>

<style>
  @reference "@/styles/global.css";

  .post-meta {
    @apply mb-[0.85rem] flex flex-wrap items-center gap-[0.55rem];
    @apply text-[0.78rem] font-bold tracking-[-0.03em] uppercase;
    color: color-mix(in srgb, var(--ink) 58%, var(--muted));
  }

  .article-layout {
    @apply relative mx-auto w-full max-w-[906px] pt-16;
    @apply max-sm:pt-[2.25rem];
  }

  .toc {
    @apply border-2 border-ink bg-bg shadow-[6px_6px_0_0_var(--ink)];
  }

  .toc-toggle {
    @apply flex w-full cursor-pointer items-center justify-between gap-4 border-0 bg-transparent px-4 py-3 text-left font-heading text-[1rem] font-bold text-ink;
  }

  .toc-toggle:hover {
    color: var(--accent);
  }

  .toc-toggle:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }

  .toc-chevron {
    @apply block shrink-0;
    width: 0.62rem;
    height: 0.62rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 220ms ease;
  }

  .toc[data-open='true'] .toc-chevron {
    transform: translateY(2px) rotate(225deg);
  }

  .toc-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .toc-panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  .toc[data-open='true'] .toc-panel {
    grid-template-rows: 1fr;
  }

  .toc-nav {
    @apply flex flex-wrap gap-x-5 gap-y-2 px-4 py-4;
    border-top: 2px solid var(--ink);
  }

  .toc-nav a {
    @apply inline-flex items-baseline gap-1 font-heading text-[0.9rem] font-semibold text-ink;
    @apply transition-colors duration-150;
  }

  .toc-nav a:hover,
  .toc-nav a[aria-current='true'] {
    color: var(--accent);
  }

  .toc-hash {
    color: var(--accent);
    font-weight: 700;
  }

  .toc[data-instant='true'] .toc-panel {
    transition: none;
  }
</style>
