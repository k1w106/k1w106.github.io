---
import ExperienceEntry from './ExperienceEntry.astro';

const platformRepositoryUrl: string = 'https://example.com/acme/platform';
const migrationWriteUpUrl: string = 'https://example.com/acme/migration-notes';
---

<ExperienceEntry
  role="Lead Engineer"
  organization={{ name: 'Acme Corp', url: 'https://example.com/' }}
  dates="January 2023 - Present"
>
  <p>
    I lead a small team that maintains the company's flagship{' '}
    <a href={platformRepositoryUrl} target="_blank" rel="noopener">
      platform
    </a>
    , from planning the roadmap to reviewing every pull request. Most of my time goes to keeping the codebase healthy:
    paying down technical debt, tightening the test suite, and mentoring teammates.
  </p>
  <p>
    One of my favorite projects was a staged migration to a modern frontend stack, documented in these
    <a href={migrationWriteUpUrl} target="_blank" rel="noopener">
      migration notes
    </a>
    . It shipped without downtime and cut the average page load time in half.
  </p>
</ExperienceEntry>
