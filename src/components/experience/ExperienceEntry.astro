---
import Card from '@/components/common/Card.astro';
import { ANIMATED_UNDERLINE_CLASSES } from '@/lib/animatedUnderline';

interface Props {
  role: string;
  dates: string;
  organization: {
    name: string;
    url?: string;
  };
}

const { role, dates, organization } = Astro.props;

const linkClasses: string[] = ['[&_a]:text-accent', ...ANIMATED_UNDERLINE_CLASSES];
---

<Card as="article">
  <h2 class:list={['m-0 text-[1.5em] leading-[1.2] font-bold tracking-[0.005em]', ...linkClasses]}>
    {role},{' '}
    {organization.url ? (
      <a href={organization.url} target="_blank" rel="noopener">
        {organization.name}
      </a>
    ) : (
      organization.name
    )}
  </h2>
  <p
    class:list={[
      'mt-3',
      'inline-block',
      'border-2',
      'border-ink',
      'bg-accent',
      'px-3',
      'py-1',
      'font-heading',
      'text-[0.8rem]',
      'leading-none',
      'font-bold',
      'text-bg',
      'shadow-[2px_2px_0_0_var(--ink)]',
    ]}
  >
    {dates}
  </p>

  <div class:list={['mt-4 space-y-4 text-ink-soft', ...linkClasses]}>
    <slot />
  </div>
</Card>
