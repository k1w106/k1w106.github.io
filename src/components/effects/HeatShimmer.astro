---
const FILTER_ID: string = 'heat-shimmer';
---

<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
  <filter id={FILTER_ID} x="-2%" y="0" width="104%" height="100%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.004 0.03" numOctaves="1" seed="4" result="noise">
      <animate
        attributeName="baseFrequency"
        dur="9s"
        values="0.004 0.03;0.006 0.045;0.004 0.03"
        repeatCount="indefinite"
      ></animate>
    </feTurbulence>
    <feDisplacementMap
      in="SourceGraphic"
      in2="noise"
      scale="3"
      xChannelSelector="R"
      yChannelSelector="G"
    ></feDisplacementMap>
  </filter>
</svg>

<div class="heat-shimmer" data-shimmer>
  <slot />
</div>

<style>
  .heat-shimmer {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-palette^='summer']) .heat-shimmer {
      filter: url(#heat-shimmer);
    }
  }
</style>
