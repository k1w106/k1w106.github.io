---
import FallingParticles from './FallingParticles.astro';
import { FLAKE_SHAPES } from '@/lib/particleShapes';
---

<FallingParticles
  family="winter"
  shapes={FLAKE_SHAPES}
  count={24}
  size={{ min: 12, spread: 12 }}
  duration={{ min: 14, spread: 12 }}
  drift={{ min: 10, spread: 30 }}
  delaySpread={24}
  peakOpacity={0.7}
  stroke
/>
