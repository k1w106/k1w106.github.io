---
import FallingParticles from './FallingParticles.astro';
import { LEAF_SHAPES } from '@/lib/particleShapes';

const LEAF_COLORS: string[] = ['var(--accent)', 'var(--pink)', 'var(--yellow)', 'var(--red)'];
---

<FallingParticles
  family="autumn"
  shapes={LEAF_SHAPES}
  colors={LEAF_COLORS}
  count={18}
  size={{ min: 24, spread: 18 }}
  duration={{ min: 12, spread: 10 }}
  drift={{ min: 20, spread: 40 }}
  delaySpread={20}
  peakOpacity={0.85}
/>
