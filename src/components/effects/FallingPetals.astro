---
import FallingParticles from './FallingParticles.astro';
import { PETAL_SHAPES } from '@/lib/particleShapes';

const PETAL_COLORS: Record<string, string[]> = {
  blossom: ['var(--accent)', 'var(--pink)'],
  oval: ['var(--pink)', 'var(--accent)'],
  flower: ['var(--accent)', 'var(--yellow)', 'var(--pink)'],
  leaf: ['var(--green)'],
};
---

<FallingParticles
  family="spring"
  shapes={PETAL_SHAPES}
  shapeColors={PETAL_COLORS}
  count={26}
  size={{ min: 14, spread: 12 }}
  duration={{ min: 13, spread: 10 }}
  drift={{ min: 25, spread: 45 }}
  delaySpread={22}
  peakOpacity={0.8}
/>
