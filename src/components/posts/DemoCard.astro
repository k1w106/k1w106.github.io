---
type Variant = 'flat' | 'raised' | 'interactive';

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = 'interactive', class: className } = Astro.props;

const raisedClasses: string = 'border-2 border-ink bg-bg-elevated shadow-[6px_6px_0_0_var(--ink)]';

const variantClasses: Record<Variant, string> = {
  flat: 'border border-line bg-bg-elevated',
  raised: raisedClasses,
  interactive: `${raisedClasses} transition-[translate,box-shadow] duration-120 hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-[3px_3px_0_0_var(--ink)]`,
};
---

<div class:list={[variantClasses[variant], className]}>
  <slot />
</div>
