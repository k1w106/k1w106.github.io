---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '@/lib/paths';
import { formatPostDate, postSlug } from '@/lib/posts';
import { slugifyTag } from '@/lib/tags';
import Card from '@/components/common/Card.astro';
import Tag from '@/components/common/Tag.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  latest?: boolean;
}

const { post, latest = false } = Astro.props;
const tags = post.data.tags.filter((tag) => slugifyTag(tag) !== '');
---

<Card as="article" hoverable class="group">
  <a class="block" href={withBase(`/blog/${postSlug(post)}/`)}>
    <div>
      <h2
        class:list={[
          'm-0',
          'text-[clamp(1.45rem,3vw,2.05rem)]',
          'leading-none',
          'font-bold',
          'tracking-[0.005em]',
          'text-ink',
          'transition-colors',
          'duration-160',
          'ease-[ease]',
          'group-hover:text-accent',
        ]}
      >
        {post.data.title}
      </h2>
      <div class="mt-3">
        <span
          class:list={[
            'inline-flex',
            'border-2',
            'border-ink',
            'font-heading',
            'text-[0.95rem]',
            'leading-none',
            'font-bold',
            'tracking-[0.04em]',
            'shadow-[3px_3px_0_0_var(--ink)]',
          ]}
        >
          <span class="bg-bg px-3 py-1 text-ink">{formatPostDate(post.data.date)}</span>
          {latest && <span class="border-l-2 border-ink bg-accent px-3 py-1 text-bg">latest</span>}
        </span>
      </div>
      <p class:list={['mt-4', 'leading-[1.55]', 'text-[color-mix(in_srgb,var(--ink)_62%,var(--muted))]']}>
        {post.data.description}
      </p>
    </div>
  </a>
  {tags.length > 0 && (
    <p class="mt-4 flex max-w-[680px] flex-wrap gap-2">
      {tags.map((tag) => (
        <Tag href={withBase(`/tags/${slugifyTag(tag)}/`)}>#{tag}</Tag>
      ))}
    </p>
  )}
</Card>
