---
import DemoCard from '@/components/posts/DemoCard.astro';

interface Props {
  color: string;
  label: string;
}

const { color, label } = Astro.props;
const swatchStyle: string = `background-color: var(--${color})`;
---

<DemoCard class="p-3 pb-5">
  <div class="aspect-[5/4] border-2 border-ink" style={swatchStyle}></div>
  <div class="mt-3 text-center font-heading font-bold">{label}</div>
</DemoCard>
