---
import Icon from '@/components/common/Icon.astro';
import { getIcon } from '@/lib/icons';
---

<button class="theme-toggle" type="button" id="theme-toggle" aria-label="Toggle color theme">
  <Icon icon={getIcon('sun')} class="theme-toggle-sun" />
  <Icon icon={getIcon('moon')} class="theme-toggle-moon" />
</button>

<script>
  import { PALETTE_CONFIG } from '@/lib/palette';

  function getCurrentPalette(): string {
    return document.documentElement.getAttribute('data-palette') ?? '';
  }

  function getNextMode(): 'light' | 'dark' {
    return getCurrentPalette().endsWith('-dark') ? 'light' : 'dark';
  }

  function getNextPalette(nextMode: string): string {
    const paletteFamily: string = getCurrentPalette().replace(/-(light|dark)$/, '');
    return `${paletteFamily}-${nextMode}`;
  }

  function togglePalette(): void {
    const nextMode: 'light' | 'dark' = getNextMode();
    document.documentElement.setAttribute('data-palette', getNextPalette(nextMode));
    localStorage.setItem(PALETTE_CONFIG.modeStorageKey, nextMode);
  }

  function initThemeToggle(): void {
    const toggleButton = document.getElementById('theme-toggle');
    toggleButton?.addEventListener('click', togglePalette);
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>

<style>
  @reference "@/styles/global.css";

  .theme-toggle {
    @apply inline-flex size-[2.1rem] items-center justify-center rounded-none border-2 border-ink bg-bg-elevated text-ink;
    @apply shadow-[3px_3px_0_0_var(--ink)] transition-[translate,box-shadow,background-color,color] duration-120 ease-[ease];
  }

  .theme-toggle:hover {
    @apply translate-x-[1px] translate-y-[1px] shadow-[2px_2px_0_0_var(--ink)];
  }

  .theme-toggle-moon {
    display: none;
  }

  :global([data-palette$='-dark']) .theme-toggle-sun {
    display: none;
  }

  :global([data-palette$='-dark']) .theme-toggle-moon {
    display: block;
  }
</style>
