---
interface Props {
  icon: string;
  class?: string;
  [attribute: string]: unknown;
}

const { icon, class: className, ...attributes } = Astro.props;
---

<svg
  class:list={['size-5', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  set:html={icon}
  {...attributes}
/>
