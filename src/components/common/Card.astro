---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  /** Element to render, e.g. `article` for standalone content. */
  as?: 'div' | 'article' | 'section' | 'li' | 'aside';
  /** Animates the card (shifts toward its shadow) on hover. */
  hoverable?: boolean;
}

const { as: Element = 'div', hoverable = false, class: className, ...rest } = Astro.props;

const cardClasses = [
  'rounded-none',
  'border-2',
  'border-ink',
  'bg-bg-elevated',
  'p-6',
  'shadow-[6px_6px_0_0_var(--ink)]',
];

const hoverableClasses = [
  'transition-[translate,box-shadow]',
  'duration-120',
  'ease-[ease]',
  'hover:translate-x-[3px]',
  'hover:translate-y-[3px]',
  'hover:shadow-[3px_3px_0_0_var(--ink)]',
];
---

<Element class:list={[cardClasses, hoverable && hoverableClasses, className]} {...rest}>
  <slot />
</Element>
