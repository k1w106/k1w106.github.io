---
interface Props {
  bold?: boolean;
  /** Draws the highlight as an uneven, hand-drawn marker stroke instead of a straight bar. */
  handDrawn?: boolean;
}

const { bold = false, handDrawn = false } = Astro.props;
const content: string = (await Astro.slots.render('default')).trim();
---

<span class:list={['highlight', { 'highlight-hand-drawn': handDrawn, 'font-semibold': bold }]} set:html={content} />

<style>
  .highlight {
    --highlight-color: color-mix(in srgb, var(--pink) 55%, transparent);
    --highlight-edge: 0.2em;
    padding-inline: 0.2em;
    margin-inline: -0.2em;
    background-image: linear-gradient(
      76deg,
      transparent var(--highlight-edge),
      var(--highlight-color) var(--highlight-edge),
      var(--highlight-color) calc(100% - var(--highlight-edge)),
      transparent calc(100% - var(--highlight-edge))
    );
    background-repeat: no-repeat;
    background-size: 100% 0.75em;
    background-position: 0 100%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* A hand-drawn marker stroke: an uneven shape (wobbly edges, overshooting ends) used as a mask,
     so it still takes its color from the palette. Below 52rem the straight highlight is used
     instead, since it can wrap across lines. */
  @media (min-width: 52rem) {
    .highlight-hand-drawn {
      position: relative;
      white-space: nowrap;
      isolation: isolate;
      background-image: none;
      padding-inline: 0.1em;
      margin-inline: 0;
    }

    .highlight-hand-drawn::before {
      content: '';
      position: absolute;
      z-index: -1;
      inset: auto -0.3em 0.02em -0.3em;
      height: 0.85em;
      background-color: var(--highlight-color);
      -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20200%2040'%20preserveAspectRatio='none'%3E%3Cpath%20d='M5%2015C3%209%2010%206%2024%207L72%204C102%202%20140%208%20176%203C191%202%20198%208%20196%2015L199%2025C200%2032%20192%2036%20180%2034C150%2038%20112%2032%2072%2036L26%2035C12%2037%204%2032%206%2025Z'/%3E%3C/svg%3E")
        center / 100% 100% no-repeat;
      mask: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20200%2040'%20preserveAspectRatio='none'%3E%3Cpath%20d='M5%2015C3%209%2010%206%2024%207L72%204C102%202%20140%208%20176%203C191%202%20198%208%20196%2015L199%2025C200%2032%20192%2036%20180%2034C150%2038%20112%2032%2072%2036L26%2035C12%2037%204%2032%206%2025Z'/%3E%3C/svg%3E")
        center / 100% 100% no-repeat;
    }
  }
</style>
