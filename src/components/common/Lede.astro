---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const baseClasses: string[] = [
  'my-[0.67em]',
  'text-[clamp(1.6rem,3.2vw,2.1rem)]',
  'leading-[1.25]',
  'font-bold',
  'tracking-[0.005em]',
  'text-ink',
];
---

<h2 class:list={[baseClasses, className]}>
  <slot />
</h2>
