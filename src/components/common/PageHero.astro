---
import Eyebrow from '@/components/common/Eyebrow.astro';

interface Props {
  title: string;
  hideTitle?: boolean;
  eyebrow?: string;
}

const { title, hideTitle = false, eyebrow } = Astro.props;
---

<section class="mx-auto max-w-(--max) px-5 pt-15 pb-1 max-sm:pt-11 max-sm:pb-7">
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h1
    class:list={[
      hideTitle
        ? 'sr-only'
        : 'm-0 max-w-[14ch] text-[clamp(2.8rem,7vw,6rem)] leading-[0.92] font-bold tracking-[-0.07em] text-ink',
    ]}
  >
    {title}
  </h1>
  <slot />
</section>
