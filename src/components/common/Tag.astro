---
interface Props {
  href: string;
  size?: 'sm' | 'lg';
}

const { href, size = 'sm' } = Astro.props;
---

<a
  class:list={['tag', size === 'lg' ? 'px-3 py-[0.22rem] text-[0.78rem]' : 'px-[0.6rem] py-[0.14rem] text-[0.7rem]']}
  href={href}
>
  <slot />
</a>

<style>
  @reference "@/styles/global.css";

  .tag {
    @apply inline-flex items-center gap-[0.35rem] rounded-none bg-[color-mix(in_srgb,var(--accent)_15%,transparent)] text-accent;
    @apply font-mono leading-[1.4] font-bold;
    @apply transition-[background-color] duration-120 ease-[ease];
  }

  .tag:hover {
    @apply bg-[color-mix(in_srgb,var(--accent)_30%,transparent)];
  }
</style>
