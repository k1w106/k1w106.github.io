---
import type { ProjectLink } from '@/lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Project {
  name: string;
  description: string;
  technologies: string[];
  links: ProjectLink[];
  isCooking?: boolean;
}

const projects: Project[] = [
  {
    name: 'Example Project',
    description: 'A short description of what this project does and the problem it solves. Replace it with your own.',
    technologies: ['TypeScript', 'Astro', 'Tailwind CSS'],
    links: [
      { kind: 'github', url: 'https://github.com/your-username/example-project' },
      { kind: 'demo', url: 'https://your-username.github.io/example-project/' },
    ],
  },
  {
    name: 'Another Project',
    description: 'A command-line tool that automates a repetitive task. Say what it is and who it is for.',
    technologies: ['Node.js', 'CLI'],
    links: [{ kind: 'github', url: 'https://github.com/your-username/another-project' }],
  },
  {
    name: 'Side Project',
    description: 'A small experiment built to learn something new. Mention what you picked up along the way.',
    technologies: ['Python', 'SQLite'],
    links: [{ kind: 'github', url: 'https://github.com/your-username/side-project' }],
  },
];
---

<section class="section grid gap-8 md:grid-cols-2" aria-label="Projects">
  {projects.map((project) => (
    <ProjectCard {...project} />
  ))}
</section>
