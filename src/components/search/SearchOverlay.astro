---
import Icon from '@/components/common/Icon.astro';
import { getIcon } from '@/lib/icons';
---

<div class="theme-overlay" id="search-overlay" hidden>
  <div class="theme-overlay-panel" role="dialog" aria-label="Search" aria-modal="true">
    <div class="search-input-row">
      <span class="search-icon" aria-hidden="true">
        <Icon icon={getIcon('search')} />
      </span>
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search posts and tags"
        aria-label="Search query"
      />
    </div>
    <div class="search-results" id="search-results" role="listbox" aria-label="Search results">
      <p class="search-empty">Type to search</p>
    </div>
    <div class="theme-overlay-footer">
      <span class="theme-overlay-hints" aria-hidden="true">
        <kbd>↑</kbd>
        <kbd>↓</kbd> navigate <kbd>↵</kbd> open
      </span>
      <span class="theme-overlay-actions">
        <button class="theme-close-btn" type="button" id="search-close-btn">
          esc
        </button>
      </span>
    </div>
  </div>
</div>

<script>
  import { withBase } from '@/lib/paths';
  import type { SearchEntry } from '@/lib/search';
  import Fuse, { type FuseResult, type RangeTuple } from 'fuse.js';

  let searchController: AbortController | undefined;
  let fuse: Fuse<SearchEntry> | null = null;
  let fuseFailed = false;

  async function loadFuse(): Promise<Fuse<SearchEntry> | null> {
    if (fuse || fuseFailed) return fuse;
    try {
      const response = await fetch(withBase('/search.json'));
      const entries: SearchEntry[] = await response.json();
      fuse = new Fuse(entries, {
        keys: [
          { name: 'title', weight: 3 },
          { name: 'tags', weight: 2 },
          { name: 'description', weight: 2 },
          { name: 'body', weight: 1 },
        ],
        threshold: 0.35,
        ignoreLocation: true,
        minMatchCharLength: 2,
        includeMatches: true,
      });
    } catch {
      fuseFailed = true;
    }
    return fuse;
  }

  const EXCERPT_RADIUS = 60;

  function getMatchIndices(result: FuseResult<SearchEntry>, key: string): readonly RangeTuple[] {
    const match = result.matches?.find((candidate) => candidate.key === key);
    return match?.indices ?? [];
  }

  function getHighlightedNodes(text: string, indices: readonly RangeTuple[]): Node[] {
    const nodes: Node[] = [];
    let cursorIndex = 0;
    indices.forEach(([startIndex, endIndex]) => {
      if (startIndex < cursorIndex) return;
      nodes.push(document.createTextNode(text.slice(cursorIndex, startIndex)));
      const mark = document.createElement('mark');
      mark.textContent = text.slice(startIndex, endIndex + 1);
      nodes.push(mark);
      cursorIndex = endIndex + 1;
    });
    nodes.push(document.createTextNode(text.slice(cursorIndex)));
    return nodes;
  }

  function getExcerptNodes(result: FuseResult<SearchEntry>): Node[] {
    const descriptionIndices = getMatchIndices(result, 'description');
    const bodyIndices = getMatchIndices(result, 'body');
    const { description, body } = result.item;
    if (descriptionIndices.length > 0 || bodyIndices.length === 0) {
      return getHighlightedNodes(description, descriptionIndices);
    }

    const [longestMatchStartIndex] = bodyIndices.reduce((longest, range) =>
      range[1] - range[0] > longest[1] - longest[0] ? range : longest,
    );
    const snippetStart = Math.max(0, longestMatchStartIndex - EXCERPT_RADIUS);
    const snippetEnd = Math.min(body.length, longestMatchStartIndex + EXCERPT_RADIUS);
    const snippet = body.slice(snippetStart, snippetEnd).replace(/\s+/g, ' ');
    const shiftedIndices: RangeTuple[] = bodyIndices
      .filter(([startIndex, endIndex]) => startIndex >= snippetStart && endIndex < snippetEnd)
      .map(([startIndex, endIndex]) => [startIndex - snippetStart, endIndex - snippetStart]);
    return getHighlightedNodes(snippet, shiftedIndices);
  }

  function initSearch() {
    searchController?.abort();
    searchController = new AbortController();
    const { signal } = searchController;

    const overlay = document.getElementById('search-overlay');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const results = document.getElementById('search-results');
    const openBtn = document.getElementById('search-open');
    const closeBtn = document.getElementById('search-close-btn');
    if (!overlay || !input || !results || !openBtn || !closeBtn) return;

    let items: HTMLAnchorElement[] = [];
    let activeIndex = -1;
    let debounceTimer: ReturnType<typeof setTimeout> | undefined;
    let queryId = 0;
    let historyIndex = -1;
    const HISTORY_KEY = 'site-search-history';

    function loadHistory(): string[] {
      try {
        const raw = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]');
        return Array.isArray(raw) ? raw.filter((q) => typeof q === 'string') : [];
      } catch {
        return [];
      }
    }

    function saveHistory(query: string) {
      const q = query.trim();
      if (!q) return;
      const history = [q, ...loadHistory().filter((h) => h !== q)].slice(0, 20);
      localStorage.setItem(HISTORY_KEY, JSON.stringify(history));
    }

    function recallHistory(index: number) {
      const history = loadHistory();
      if (index < 0) {
        historyIndex = -1;
        input!.value = '';
        setEmpty('Type to search');
        return;
      }
      if (index >= history.length) return;
      historyIndex = index;
      input!.value = history[index] ?? '';
      void runSearch(input!.value);
    }

    function setEmpty(message: string) {
      if (!results) return;
      results.innerHTML = '';
      const p = document.createElement('p');
      p.className = 'search-empty';
      p.textContent = message;
      results.append(p);
      items = [];
      activeIndex = -1;
    }

    function setActive(index: number) {
      activeIndex = index;
      items.forEach((item, i) => {
        item.setAttribute('aria-selected', String(i === index));
      });
      items[index]?.scrollIntoView({ block: 'nearest' });
    }

    async function runSearch(query: string) {
      const id = ++queryId;
      if (!query.trim()) {
        setEmpty('Type to search');
        return;
      }
      const searchIndex = await loadFuse();
      if (!searchIndex) {
        setEmpty('Search index could not be loaded.');
        return;
      }
      if (id !== queryId || !results) return;
      const top: FuseResult<SearchEntry>[] = searchIndex.search(query, { limit: 8 });
      if (top.length === 0) {
        setEmpty(`No matches for "${query}"`);
        return;
      }
      results.innerHTML = '';
      items = top.map((result) => {
        const link = document.createElement('a');
        link.className = 'search-result';
        link.href = result.item.url;
        link.setAttribute('role', 'option');
        const title = document.createElement('span');
        title.className = 'search-result-title';
        title.append(...getHighlightedNodes(result.item.title, getMatchIndices(result, 'title')));
        const excerpt = document.createElement('span');
        excerpt.className = 'search-result-excerpt';
        excerpt.append(...getExcerptNodes(result));
        link.append(title, excerpt);
        link.addEventListener('click', () => saveHistory(input!.value), { signal });
        results.append(link);
        return link;
      });
      setActive(0);
    }

    function openOverlay() {
      overlay!.hidden = false;
      document.body.style.overflow = 'hidden';
      input!.value = '';
      historyIndex = -1;
      setEmpty('Type to search');
      input!.focus();
      void loadFuse();
    }

    function closeOverlay() {
      overlay!.hidden = true;
      document.body.style.overflow = '';
    }

    input.addEventListener(
      'input',
      () => {
        historyIndex = -1;
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => runSearch(input.value), 150);
      },
      { signal },
    );

    openBtn.addEventListener('click', openOverlay, { signal });
    closeBtn.addEventListener('click', closeOverlay, { signal });
    overlay.addEventListener(
      'click',
      (e) => {
        if (e.target === overlay) closeOverlay();
      },
      { signal },
    );

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'k' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          if (overlay.hidden) openOverlay();
          else closeOverlay();
          return;
        }
        if (overlay.hidden) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          closeOverlay();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (historyIndex >= 0) {
            recallHistory(historyIndex - 1);
          } else if (items.length > 0) {
            setActive(Math.min(items.length - 1, activeIndex + 1));
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (historyIndex >= 0 || input.value.trim() === '') {
            recallHistory(historyIndex + 1);
          } else if (items.length > 0) {
            setActive(Math.max(0, activeIndex - 1));
          }
        } else if (e.key === 'Enter') {
          const active = items[activeIndex];
          if (active) {
            e.preventDefault();
            active.click();
          }
        } else if (e.key === 'Tab') {
          const focusables = [input, ...items, closeBtn].filter(Boolean) as HTMLElement[];
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (!first || !last) return;
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      },
      { signal },
    );
  }

  document.addEventListener('astro:page-load', initSearch);
</script>

<style is:global>
  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.9rem 0.9rem 0;
    padding: 0.55rem 0.8rem;
    border: 2px solid var(--ink);
    background: var(--bg);
    box-shadow: 3px 3px 0 0 var(--ink);
    color: var(--ink);
  }

  .search-icon {
    display: inline-flex;
    flex: none;
  }

  .search-input-row input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--ink);
    caret-color: var(--accent);
    font-family: var(--heading);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .search-input-row input::placeholder {
    color: var(--muted);
    font-weight: 500;
  }

  .search-input-row input::-webkit-search-cancel-button {
    display: none;
  }

  .search-results {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 9rem;
    max-height: 50vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    scrollbar-gutter: stable;
    padding: 0.9rem;
    scrollbar-width: thin;
    scrollbar-color: var(--ink) var(--bg);
  }

  .search-results::-webkit-scrollbar {
    width: 8px;
  }
  .search-results::-webkit-scrollbar-track {
    background: var(--bg);
  }
  .search-results::-webkit-scrollbar-thumb {
    background: var(--ink);
  }

  .search-result {
    display: block;
    padding: 0.65rem 0.85rem;
    border: 2px solid var(--ink);
    background: var(--bg-elevated);
    box-shadow: 3px 3px 0 0 var(--ink);
    color: var(--ink);
    text-decoration: none;
    transition:
      translate 120ms ease,
      box-shadow 120ms ease,
      background-color 120ms ease;
  }

  .search-result:hover,
  .search-result:focus-visible,
  .search-result[aria-selected='true'] {
    outline: none;
    translate: 1px 1px;
    background: var(--accent);
    box-shadow: 2px 2px 0 0 var(--ink);
    color: var(--bg);
  }

  .search-result-title {
    display: block;
    font-family: var(--heading);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .search-result-excerpt {
    display: block;
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .search-result:hover .search-result-excerpt,
  .search-result:focus-visible .search-result-excerpt,
  .search-result[aria-selected='true'] .search-result-excerpt {
    color: var(--bg);
  }

  .search-result mark {
    padding-inline: 0.15em;
    margin-inline: -0.15em;
    background: color-mix(in srgb, var(--pink) 55%, transparent);
    color: inherit;
    font-weight: 700;
  }

  .search-result:hover mark,
  .search-result:focus-visible mark,
  .search-result[aria-selected='true'] mark {
    background: var(--bg);
    color: var(--ink);
  }

  .search-empty {
    margin: 0;
    padding: 1rem 0.2rem;
    color: var(--muted);
    font-family: var(--heading);
    font-size: 0.95rem;
    font-weight: 500;
  }
</style>
