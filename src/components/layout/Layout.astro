---
import { ClientRouter } from 'astro:transitions';
import SearchOverlay from '@/components/search/SearchOverlay.astro';
import SmartCursor from '@/components/layout/SmartCursor.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/header/index.astro';
import { withBase } from '@/lib/paths';
import { SITE_NAME } from '@/lib/site';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
}

const { title, description, canonicalPath = '/', ogType = 'website' } = Astro.props;

const canonicalUrl = new URL(withBase(canonicalPath), Astro.site).toString();
const ogImageUrl = new URL(withBase('/assets/og.png'), Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f0eee9" />
    <link rel="preload" href={withBase('/assets/inter.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/assets/space-grotesk.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/assets/jetbrains-mono.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script>
      import { initializePalette } from '@/lib/palette';

      initializePalette();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Header />

    <slot />

    <Footer />

    <SearchOverlay />

    <SmartCursor />
  </body>
</html>
